# Copie este arquivo para .env e ajuste os valores locais.
# Nunca versione o arquivo .env real.

# Obrigatório em produção: gere com
# python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=coloque-aqui-uma-chave-ficticia-de-desenvolvimento

# Desenvolvimento: True. Produção: False.
DJANGO_DEBUG=True

# Hosts permitidos, separados por vírgula.
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Banco de dados: sqlite (Fase 1) ou postgresql (a partir da Fase 2).
DB_ENGINE=sqlite

# Configuração PostgreSQL (usada quando DB_ENGINE=postgresql).
DB_NAME=controle_emprestimos
DB_USER=controle_app
DB_PASSWORD=senha-ficticia
DB_HOST=127.0.0.1
DB_PORT=5432

# Produção: origens confiáveis para CSRF, separadas por vírgula.
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SECURE_HSTS_SECONDS=31536000
